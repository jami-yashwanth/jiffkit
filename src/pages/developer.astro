---
import Base from '../layouts/Base.astro';
import Zone from '../components/Zone.astro';
import { DEV_ZONES } from '../wall';

// Every developer tool: the 25 dev tools plus the four text/QR tools from round 2, each in one group's zone.
const count = DEV_ZONES.reduce((n, z) => n + z.tools.length, 0);
---
<Base
  title="Developer Tools - Free, Private, Run in Your Browser"
  description={`${count} free developer tools: hash, UUID, regex, cron, SQL, YAML, CSV, JWT and more. They run in your browser, so nothing you paste is ever uploaded.`}
  path="/developer/"
  wide
>
  <div class="hero">
    <h1>Developer tools</h1>
    <p class="subhead">{count} everyday tools for code and data. Safe for tokens, keys and customer data: nothing you paste leaves your&nbsp;browser.</p>
  </div>

  <div class="wall wall-dev">
    {DEV_ZONES.map((z) => <Zone zone={z} />)}
  </div>
</Base>
