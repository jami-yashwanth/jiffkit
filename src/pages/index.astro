---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { TOOLS, type Category } from '../tools';

const order: Category[] = ['image', 'pdf', 'ai', 'video', 'developer', 'qr'];
const tools = order.flatMap((c) => TOOLS.filter((t) => t.category === c));
// A chip shows these categories; Developer also covers the one QR tool.
const chips: [string, string][] = [['All', ''], ['Image', 'image'], ['PDF', 'pdf'], ['AI', 'ai'], ['Video', 'video'], ['Developer', 'developer qr']];
// The site name search engines show next to the result, in place of a brand suffix on every title.
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'jiffkit', url: new URL('/', Astro.site).href };
---
<Base
  title="jiffkit - Private Image, PDF, Video and AI Tools"
  description="Free tools that run on your device: remove backgrounds, transcribe audio, compress video, merge PDFs and convert photos. Nothing is uploaded."
  path="/"
  jsonLd={website}
  wide
>
  <div class="home-hero">
    <h1>Tools that never upload your files</h1>
    <p class="subhead">Remove backgrounds, transcribe audio, compress video, merge PDFs and convert photos right in your browser. Free,&nbsp;no&nbsp;sign-up.</p>
  </div>

  <!-- Hidden until the script below runs: without JavaScript every card shows and no chip does nothing. -->
  <div class="chips" role="group" aria-label="Filter tools" hidden>
    {chips.map(([label, cats], i) => (
      <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-cats={cats}>{label}</button>
    ))}
  </div>

  <ul id="tools" class="card-grid">
    {tools.map((t) => <li data-category={t.category}><ToolCard tool={t} /></li>)}
  </ul>

  <script is:inline>
    (function () {
      var g = document.querySelector('.chips'), bs = g.querySelectorAll('button'), lis = document.querySelectorAll('#tools li');
      g.hidden = false;
      bs.forEach(function (b) {
        b.addEventListener('click', function () {
          var cats = b.dataset.cats ? b.dataset.cats.split(' ') : null;
          bs.forEach(function (o) { o.setAttribute('aria-pressed', String(o === b)); });
          lis.forEach(function (li) { li.hidden = !!cats && cats.indexOf(li.dataset.category) < 0; });
        });
      });
    })();
  </script>
</Base>
