---
import Base from '../layouts/Base.astro';
import { CATEGORY_LABEL, TOOLS, type Category } from '../tools';

const order: Category[] = ['image', 'pdf', 'ai', 'video', 'developer', 'qr'];
// The site name search engines show next to the result, in place of a brand suffix on every title.
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'jiffkit', url: new URL('/', Astro.site).href };
---
<Base
  title="jiffkit - Private Image, PDF, Video and AI Tools"
  description="Free tools that run on your device: remove backgrounds, transcribe audio, compress video, merge PDFs and convert photos. Nothing is uploaded."
  path="/"
  jsonLd={website}
>
  <h1>Tools that never upload your files</h1>
  <p class="subhead">Remove backgrounds, transcribe audio, compress video, merge PDFs and convert photos right in your browser. Free,&nbsp;no&nbsp;sign-up.</p>

  <label for="filter" class="subhead">Find a tool</label>
  <input id="filter" class="filter" type="search" placeholder="Try PDF, video, background or HEIC" autocomplete="off" />

  <div id="tools">
    {order.map((c) => (
      <section class="category">
        <h2>{CATEGORY_LABEL[c]}</h2>
        <ul class="tool-list">
          {TOOLS.filter((t) => t.category === c).map((t) => (
            <li data-name={`${t.h1} ${t.subhead}`.toLowerCase()}>
              <a href={`/${t.slug}/`}><strong>{t.h1}</strong>{t.subhead}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <p id="no-match" hidden>No tool matches that. Try "PDF", "video", "background" or "HEIC".</p>

  <script is:inline>
    (function () {
      var i = document.getElementById('filter'), m = document.getElementById('no-match'), s = document.querySelectorAll('.category');
      i.addEventListener('input', function () {
        var q = i.value.trim().toLowerCase(), n = 0;
        s.forEach(function (c) {
          var k = 0;
          c.querySelectorAll('li').forEach(function (li) { var h = li.dataset.name.indexOf(q) < 0; li.hidden = h; if (!h) k++; });
          c.hidden = !k; n += k;
        });
        m.hidden = n > 0;
      });
    })();
  </script>
</Base>
