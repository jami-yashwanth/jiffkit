---
import Base from '../layouts/Base.astro';
import HomeWall from '../components/HomeWall.astro';
import Icon from '../components/Icon.astro';
import { CHECK } from '../icons';

// The site name search engines show next to the result, in place of a brand suffix on every title.
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'jiffkit', url: new URL('/', Astro.site).href };
---
<Base
  title="jiffkit - Private Image, PDF, Video and AI Tools"
  description="Free tools that run on your device: remove backgrounds, transcribe audio, compress video, merge PDFs and convert photos. Nothing is uploaded."
  path="/"
  jsonLd={website}
  wide
>
  <div class="hero">
    <h1>Free tools for images, PDFs, video and code</h1>
    <ul class="promises">
      {['Nothing uploaded', 'No account', 'No watermarks'].map((p) => <li><Icon svg={CHECK} size={16} />{p}</li>)}
    </ul>
  </div>

  <HomeWall />
</Base>
