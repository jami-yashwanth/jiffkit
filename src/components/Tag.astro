---
import Icon from './Icon.astro';
import type { Tool } from '../tools';

// A tool on a wall: its icon and its name, linking to the tool.
interface Props { tool: Tool }
const { tool } = Astro.props;
---
<a class="tag" href={`/${tool.slug}/`}><span class="tag-icon"><Icon slug={tool.slug} size={22} /></span><strong class="tag-name">{tool.tagName ?? tool.h1}</strong></a>
