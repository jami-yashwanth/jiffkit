---
import type { AiTool } from '../tools';
import { MODELS, megabytes, type ModelKey } from '../ai/config';

interface Props { tool: AiTool }
const { tool } = Astro.props;
// Spec §4 empty states. The island (src/ui/ai.ts) takes over once its script loads.
const COPY = {
  bg: { title: 'Drop a photo here', choose: 'Choose photo', noun: 'photos' },
  ocr: { title: 'Drop an image with text', choose: 'Choose image', noun: 'images' },
  upscale: { title: 'Drop an image', choose: 'Choose image', noun: 'images' },
  whisper: { title: 'Drop an audio or video file', choose: 'Choose file', noun: 'files' },
}[tool.model];
// First-use download, from the model list. Remove background uses a ~5 MB model on phones and low-memory devices.
const MODEL_KEY: Record<AiTool['model'], ModelKey> = { bg: 'bg', ocr: 'tessdata', upscale: 'upscale', whisper: 'whisper' };
const MODEL_BYTES = MODELS[MODEL_KEY[tool.model]].bytes;
const MODEL_SIZE = megabytes(MODEL_BYTES);
const MODEL_SIZE_SMALL = tool.model === 'bg' ? megabytes(MODELS.bgSmall.bytes) : undefined;
---
<div
  data-kind="ai"
  data-tool={tool.slug}
  data-model={tool.model}
  data-model-size={MODEL_SIZE}
  data-model-bytes={MODEL_BYTES}
  {...(MODEL_SIZE_SMALL ? { 'data-model-size-small': MODEL_SIZE_SMALL } : {})}
>
  <div class="drop">
    <p class="drop-title">{COPY.title}</p>
    <label class="btn">
      {COPY.choose}
      <input type="file" accept={tool.accepts} />
    </label>
    <p class="privacy">Runs on your device with on-device AI. Your {COPY.noun} are never uploaded.</p>
  </div>
  <p class="status" role="status" aria-live="polite" data-status></p>
  <div data-results></div>
</div>

<script>
  import { mountAi } from '../ui/ai';
  // Each tool's definition is its own chunk, imported only on that tool's page.
  const el = document.querySelector<HTMLElement>('[data-kind="ai"]');
  if (el?.dataset.model === 'ocr') void import('../ui/ocr').then(({ ocrDef }) => mountAi(el, ocrDef()));
  if (el?.dataset.model === 'bg') void import('../ui/bg').then(({ bgDef }) => mountAi(el, bgDef()));
</script>
