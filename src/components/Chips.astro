---
// Category chips over a card grid (#tools li[data-category]). Hidden until the script runs: without JavaScript every
// card shows and no chip does nothing. Each chip lists the categories it shows, space-separated; '' shows all.
interface Props { chips: [label: string, categories: string][] }
const { chips } = Astro.props;
---
<div class="chips" role="group" aria-label="Filter tools" hidden>
  {chips.map(([label, cats], i) => (
    <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-cats={cats}>{label}</button>
  ))}
</div>

<script is:inline>
  (function () {
    // The grid comes after the chips in the page, so its cards are looked up on each click, not now.
    var g = document.querySelector('.chips'), bs = g.querySelectorAll('button');
    g.hidden = false;
    bs.forEach(function (b) {
      b.addEventListener('click', function () {
        var cats = b.dataset.cats ? b.dataset.cats.split(' ') : null, lis = document.querySelectorAll('#tools li');
        bs.forEach(function (o) { o.setAttribute('aria-pressed', String(o === b)); });
        lis.forEach(function (li) { li.hidden = !!cats && cats.indexOf(li.dataset.category) < 0; });
      });
    });
  })();
</script>
