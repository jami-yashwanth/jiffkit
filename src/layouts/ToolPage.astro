---
import Base from './Base.astro';
import { getTool, type Tool } from '../tools';

interface Props { tool: Tool }
const { tool } = Astro.props;
const isHeic = tool.slug === 'heic-to-jpg';
const noun = isHeic ? 'photos' : 'images';
const chooseLabel = isHeic ? 'Choose photos' : 'Choose images';
const related = tool.related.map(getTool);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title={tool.title} description={tool.description} path={`/${tool.slug}/`} jsonLd={jsonLd}>
  <h1>{tool.h1}</h1>
  <p class="subhead">{tool.subhead}</p>

  <div
    data-tool={tool.slug}
    data-accept={tool.acceptAttr}
    data-quality={tool.defaults.quality}
    data-format={tool.defaults.format ?? 'same'}
  >
    <div class="drop">
      <p class="drop-title">{tool.emptyCopy}</p>
      <label class="btn">
        {chooseLabel}
        <input type="file" multiple accept={tool.acceptAttr} />
      </label>
      <p class="privacy">Converted on your device. Your {noun} are never uploaded.</p>
    </div>
  </div>

  <div data-results aria-live="polite"></div>

  <section>
    <h2>How it works</h2>
    <ol>{tool.howTo.map((step) => <li>{step}</li>)}</ol>
  </section>

  <section>
    <h2>Questions</h2>
    <dl class="faq">
      {tool.faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
    </dl>
  </section>

  <section>
    <h2>Related tools</h2>
    <ul class="tool-list">
      {related.map((r) => (
        <li><a href={`/${r.slug}/`}><strong>{r.h1}</strong>{r.subhead}</a></li>
      ))}
    </ul>
  </section>
</Base>
