---
import Base from './Base.astro';
import ImageTool from '../components/ImageTool.astro';
import PdfTool from '../components/PdfTool.astro';
import AiTool from '../components/AiTool.astro';
import VideoTool from '../components/VideoTool.astro';
import TextTool from '../components/TextTool.astro';
import QrTool from '../components/QrTool.astro';
import DevTool from '../components/DevTool.astro';
import Icon from '../components/Icon.astro';
import Tag from '../components/Tag.astro';
import { getTool, type Tool } from '../tools';
import { ARROW_RIGHT } from '../icons';
import { IO, placeOf } from '../wall';

interface Props { tool: Tool }
const { tool } = Astro.props;
const related = tool.related.map(getTool);
const place = placeOf(tool.slug);
const io = IO[tool.slug];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title={tool.title} description={tool.description} path={`/${tool.slug}/`} jsonLd={jsonLd}>
  <header class="tool-head" data-zone={place.zone}><span class="tool-tile"><Icon slug={tool.slug} size={32} /></span><h1>{tool.h1}</h1><p class="subhead">{tool.subhead}</p></header>

  <div class="bench" data-zone={place.zone}>
  <p class="bench-io"><b>In</b> {io[0]} <Icon svg={ARROW_RIGHT} size={16} /><span class="visually-hidden">, </span> <b>Out</b> {io[1]}</p>
  {tool.kind === 'image' && <ImageTool tool={tool} />}
  {tool.kind === 'pdf' && <PdfTool tool={tool} />}
  {tool.kind === 'ai' && <AiTool tool={tool} />}
  {tool.kind === 'video' && <VideoTool tool={tool} />}
  {tool.kind === 'text' && <TextTool tool={tool} />}
  {tool.kind === 'qr' && <QrTool tool={tool} />}
  {tool.kind === 'dev' && <DevTool tool={tool} />}
  </div>

  <section>
    <h2>How it works</h2>
    <ol class="courses">{tool.howTo.map((step) => <li>{step}</li>)}</ol>
  </section>

  <section>
    <h2>Questions</h2>
    <dl class="faq">
      {tool.faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
    </dl>
  </section>

  <section>
    <h2>Related tools</h2>
    <ul class="pegs related">
      {related.map((r) => <li data-zone={placeOf(r.slug).zone}><Tag tool={r} /></li>)}
    </ul>
  </section>
</Base>
