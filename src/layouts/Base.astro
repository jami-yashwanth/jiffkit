---
import '../styles/tokens.css';
import { jsonLdString } from '../json-ld';
import Search from '../components/Search.astro';
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMono from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import bungee from '@fontsource/bungee/files/bungee-latin-400-normal.woff2?url';

// Geist and Geist Mono, self-hosted: Latin only, every weight in one variable file each. Geist is preloaded so the
// first paint uses it; Geist Mono downloads only on pages that show code. Bungee sets the wordmark, and only that, so it
// is preloaded too (14 KB).
const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = [
  ['Geist', geist],
  ['Geist Mono', geistMono],
].map(([family, url]) => `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:100 900;src:url(${url}) format('woff2');unicode-range:${LATIN}}`).join('') +
  `@font-face{font-family:'Bungee';font-style:normal;font-display:swap;font-weight:400;src:url(${bungee}) format('woff2');unicode-range:${LATIN}}`;

interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/heic-to-jpg/"
  jsonLd?: object;
  wide?: boolean; // the homepage grid; every other page keeps the reading measure
}
const { title, description, path, jsonLd, wide = false } = Astro.props;
// Umami Cloud analytics, only on builds that set the website ID (production). Cookieless; events carry only a tool name
// and a count or reason (src/ui/track.ts). Do Not Track is respected.
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const canonical = new URL(path, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bungee} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="jiffkit" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      umamiWebsiteId && (
        <>
          <script is:inline>window.umamiQ = window.umamiQ || [];</script>
          <script
            is:inline
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id={umamiWebsiteId}
            data-do-not-track="true"
            onload="window.umamiQ.splice(0).forEach(function (e) { window.umami.track(e[0], e[1]); })"
          />
        </>
      )
    }
    {jsonLd && <script type="application/ld+json" set:html={jsonLdString(jsonLd)} />}
  </head>
  <body>
    <!-- The top bar and the footer are one width on every page; only the content between them narrows to the reading
         measure on tool and reading pages. -->
    <header class="topbar">
      <div class="frame topbar-in">
        <a class="wordmark" href="/">jiffkit</a>
        <Search />
      </div>
    </header>
    <div class:list={['page', { 'page-wide': wide }]}>
      <main><slot /></main>
    </div>
    <footer class="site-footer">
      <p class="frame">Everything runs on your device. <a href="/privacy/">Privacy</a> · <a href="/licenses/">Open-source licences</a> · <a href="https://github.com/jami-yashwanth/jiffkit">Source code</a></p>
    </footer>
  </body>
</html>
